# cmake -DOUTPUT=<header> -DINPUTS=<file|file|...> -P EmbedFiles.cmake
# Writes each file as `static const unsigned char k_<name>[]` (name with
# '.' replaced by '_') plus its size.
string(REPLACE "|" ";" files "${INPUTS}")
set(text "// Generated by cmake/EmbedFiles.cmake; do not edit.\n#pragma once\n#include <cstddef>\n\n")
foreach(file ${files})
	get_filename_component(name ${file} NAME)
	string(MAKE_C_IDENTIFIER ${name} id)
	file(READ ${file} hex HEX)
	string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
	string(LENGTH "${hex}" length)
	math(EXPR size "${length} / 2")
	string(APPEND text "static const unsigned char k_${id}[] = {${bytes}};\nstatic const size_t k_${id}_size = ${size};\n\n")
endforeach()
file(WRITE ${OUTPUT} "${text}")
