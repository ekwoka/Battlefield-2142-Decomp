Enhanced variant of particle.frag (enhanced.particleShadows): add the
directional light change as a particle moves into shadow. material.rgb
is shaded minus sunlit light (LevelRenderer::drawParticles).
<<<<
#include "fog.glsl"
====
#include "fog.glsl"
#define SHADOW_UNIFORM_BINDING 1
#define SHADOW_MAP_BINDING 1
#include "enhanced_shadow.glsl"
layout(location = 3) in vec4 inShadowAt;
layout(location = 4) in vec3 inParticleTint;
>>>>
<<<<
	outColor = vec4(mix(texel.rgb * inColor.rgb, fogColor.rgb, fog), texel.a * inColor.a);
====
	float shade = (1.0 - shadowFactor(inShadowAt.xyz, true)) * inShadowAt.w;
	vec3 color = inColor.rgb + inParticleTint * material.rgb * shade;
	outColor = vec4(mix(texel.rgb * color, fogColor.rgb, fog), texel.a * inColor.a);
